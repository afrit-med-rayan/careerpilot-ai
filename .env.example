# ─────────────────────────────────────────────────────────────────────────────
# CareerPilot AI — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose default (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@db:5432/careerpilot
# Local development without Docker:
# DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_use_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # 24 hours

# ── LLM ──────────────────────────────────────────────────────────────────────
# Required for Phase 2+ features (ATS analysis, rewrites, cover letters, etc.)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Job APIs ─────────────────────────────────────────────────────────────────
# Adzuna: register free at https://developer.adzuna.com/
# Leave blank to use Remotive (keyless) as the only job source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" stores uploads in LOCAL_UPLOAD_DIR on disk.
# "s3" (future): set AWS_* vars and use an S3-compatible bucket.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to "true" to log full LLM prompts and responses (verbose — dev only)
DEBUG_LOG_LLM=false
